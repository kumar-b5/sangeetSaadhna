---
import Layout from '../components/Layout.astro';
import CTA from '../components/CTA.astro';
import PageSection from '../components/PageSection.astro';
import { fetchPageBySlug, fetchSiteSettings } from '../lib/sanityQueries';

const slug = 'contact';
const canUseSanity =
  Boolean(import.meta.env.SANITY_PROJECT_ID) && Boolean(import.meta.env.SANITY_DATASET);

let page = null;
let siteSettings = null;

if (canUseSanity) {
  try {
    [page, siteSettings] = await Promise.all([
      fetchPageBySlug(slug),
      fetchSiteSettings(),
    ]);
  } catch (error) {
    console.warn(`Failed to fetch Sanity content for ${slug} page`, error);
  }
}

const title = page?.heroTitle ?? 'Connect With Sangeet Saadhna';
const intro =
  page?.heroSubtitle ??
  'Reach out with questions about monthly programs, volunteering, artist collaborations, or donations. Our organizers will get back within 2–3 days.';

const contactEmail = siteSettings?.primaryEmail ?? 'rsvp@sangeetsaadhna.org';
const contactPhone = siteSettings?.contactPhone ?? '(555) 123-4567';
const location = siteSettings?.location ?? 'Community Hall, 123 Raag Avenue, San Francisco Bay Area';
const mapLink = siteSettings?.mapLink ?? 'https://maps.google.com';

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: 'Community Relations',
    email: contactEmail,
    telephone: contactPhone,
  },
};
---

<Layout title={`${title} | Sangeet Saadhna`} description={intro} structuredData={structuredData}>
  <PageSection eyebrow="Connect" title={title} intro={intro} content={page?.blocks}>
    {!page?.blocks && (
      <div class="contact-fallback">
        <p>
          Looking to perform, volunteer, or collaborate? Fill out the form below or drop us a note
          and we’ll be in touch shortly.
        </p>
      </div>
    )}
  </PageSection>

  <section class="section">
    <div class="container contact-grid">
      <article class="card contact-card">
        <h2>Reach out</h2>
        <dl>
          <div>
            <dt>Email</dt>
            <dd><a href={`mailto:${contactEmail}`}>{contactEmail}</a></dd>
          </div>
          <div>
            <dt>Phone</dt>
            <dd><a href={`tel:${contactPhone}`}>{contactPhone}</a></dd>
          </div>
          <div>
            <dt>Location</dt>
            <dd>{location}</dd>
          </div>
        </dl>
        <CTA
          variant="outline"
          heading="Join the volunteer circle."
          body="Sound, hospitality, communications, and design teams are always growing."
          buttonLabel="Volunteer interest form"
          buttonHref="/donation"
        />
      </article>
      <article class="card form-card">
        <h2>Send a message</h2>
        <form method="post" action="/api/contact" class="contact-form">
          <div class="field">
            <label for="name">Full name</label>
            <input id="name" name="name" type="text" required autocomplete="name" />
          </div>
          <div class="field-grid">
            <div class="field">
              <label for="email">Email</label>
              <input id="email" name="email" type="email" required autocomplete="email" />
            </div>
            <div class="field">
              <label for="subject">Subject</label>
              <input id="subject" name="subject" type="text" required />
            </div>
          </div>
          <div class="field">
            <label for="message">Message</label>
            <textarea id="message" name="message" rows="5" required></textarea>
          </div>
          <div class="field">
            <label for="interest">How would you like to engage?</label>
            <select id="interest" name="interest">
              <option value="attend">Attend a program</option>
              <option value="perform">Perform / collaborate</option>
              <option value="volunteer">Volunteer</option>
              <option value="donate">Donation</option>
              <option value="other">Other</option>
            </select>
          </div>
          <button class="btn" type="submit">Submit</button>
          <p class="form-disclaimer">
            We’ll never share your information. Expect a follow-up within 2–3 business days.
          </p>
          <p class="form-status" data-contact-status hidden></p>
        </form>
      </article>
    </div>
  </section>

  <section class="section">
    <div class="container map-card">
      <iframe
        src={`${mapLink.replace('edit', 'view')}?output=embed`}
        loading="lazy"
        allowfullscreen
        referrerpolicy="no-referrer-when-downgrade"
        title="Sangeet Saadhna location map"
      />
      <div class="map-card__body">
        <h2>Visit a monthly baithak</h2>
        <p>
          Rotating venues across the Bay Area keep gatherings accessible. RSVP for details on the
          upcoming location, parking, and hospitality guidelines.
        </p>
        <a class="btn outline" href="/events">See upcoming programs</a>
      </div>
    </div>
  </section>
</Layout>

<script is:inline type="module">
const form = document.querySelector('.contact-form');
const statusEl = document.querySelector('[data-contact-status]');

if (form instanceof HTMLFormElement && statusEl instanceof HTMLElement) {
  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    statusEl.hidden = false;
    statusEl.textContent = 'Submitting...';
    try {
      const response = await fetch(form.action, {
        method: 'POST',
        body: new FormData(form),
      });
      if (response.ok) {
        statusEl.textContent =
          'Thank you for reaching out! We will connect with you shortly.';
        form.reset();
      } else {
        statusEl.textContent =
          'We could not send your message right now. Please try again later.';
      }
    } catch (error) {
      statusEl.textContent =
        'We could not send your message right now. Please try again later.';
    }
  });
}
</script>

<style>
  .contact-fallback {
    color: var(--color-text-muted);
  }

  .contact-grid {
    display: grid;
    gap: clamp(1.5rem, 3vw, 2.5rem);
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  }

  .contact-card dl {
    margin: 0;
    display: grid;
    gap: 1rem;
  }

  .contact-card dt {
    font-weight: 600;
    color: var(--color-primary);
  }

  .contact-card dd {
    margin: 0.35rem 0 0;
    color: var(--color-text-muted);
  }

  .form-card {
    display: grid;
    gap: 1.25rem;
  }

  .contact-form {
    display: grid;
    gap: 1rem;
  }

  .field {
    display: grid;
    gap: 0.45rem;
  }

  .field label {
    font-weight: 600;
  }

  .field-grid {
    display: grid;
    gap: 1rem;
  }

  .field-grid .field {
    width: 100%;
  }

  input,
  textarea,
  select {
    border: 1px solid rgba(15, 23, 42, 0.15);
    border-radius: var(--radius-sm);
    padding: 0.75rem 1rem;
    font-size: 1rem;
    font-family: inherit;
    transition: border 150ms ease, box-shadow 150ms ease;
  }

  input:focus-visible,
  textarea:focus-visible,
  select:focus-visible {
    outline: none;
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px rgba(75, 29, 149, 0.15);
  }

  .form-disclaimer {
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }

  .form-status {
    font-size: 0.9rem;
    color: var(--color-primary-dark);
  }

  .map-card {
    display: grid;
    gap: 1.5rem;
    background: var(--color-surface);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-card);
    overflow: hidden;
  }

  .map-card iframe {
    width: 100%;
    min-height: 320px;
    border: 0;
  }

  .map-card__body {
    padding: clamp(1.5rem, 3vw, 2.5rem);
    display: grid;
    gap: 0.9rem;
  }

  @media (min-width: 680px) {
    .field-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .map-card {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
