---
type EventRecord = {
  title: string;
  slug: string;
  startDate?: string;
  endDate?: string;
  location?: string;
  shortDescription?: string;
  youtubeUrl?: string;
  categories?: string[];
  heroImage?: {
    asset?: {
      url?: string;
      metadata?: {
        lqip?: string;
        dimensions?: {
          width: number;
          height: number;
        };
      };
    };
  };
};

interface Props {
  event: EventRecord;
  variant?: 'default' | 'featured';
}

const { event, variant = 'default' } = Astro.props as Props;

const eventLink = event.slug ? `/events/${event.slug}` : '#';
const startDate = event.startDate ? new Date(event.startDate) : null;
const endDate = event.endDate ? new Date(event.endDate) : null;

const formatDate = (date: Date | null) =>
  date
    ? new Intl.DateTimeFormat('en-US', {
        month: 'long',
        day: 'numeric',
        year: startDate?.getFullYear() !== endDate?.getFullYear() ? 'numeric' : undefined,
        hour: 'numeric',
        minute: '2-digit',
      }).format(date)
    : null;

const startLabel = formatDate(startDate);
const endLabel =
  endDate && startDate?.toDateString() !== endDate.toDateString()
    ? formatDate(endDate)
    : null;

const heroImage = event.heroImage?.asset?.url;
const lqip = event.heroImage?.asset?.metadata?.lqip;
---

<article class:list={{ card: true, 'event-card': true, featured: variant === 'featured' }}>
  <a class="event-card__cover" href={eventLink} aria-label={`Read about ${event.title}`}>
    {heroImage ? (
      <img
        src={heroImage}
        alt={event.title}
        loading="lazy"
        decoding="async"
        style={lqip ? `background-image: url(${lqip});` : ''}
      />
    ) : (
      <div class="event-card__placeholder">
        <span>Monthly program</span>
      </div>
    )}
    <div class="event-card__badge">
      <span class="badge">
        {startDate ? new Intl.DateTimeFormat('en-US', { month: 'short' }).format(startDate) : 'Event'}
        {startDate ? ` ${startDate.getDate()}` : ''}
      </span>
    </div>
  </a>
  <div class="event-card__content">
    {event.categories && event.categories.length > 0 && (
      <div class="event-card__tags">
        {event.categories.map((category) => (
          <span class="tag">{category.replace('-', ' ')}</span>
        ))}
      </div>
    )}
    <h3>
      <a href={eventLink}>{event.title}</a>
    </h3>
    {startLabel && (
      <p class="event-card__meta">
        <strong>{startLabel}</strong>
        {endLabel && <span> – {endLabel}</span>}
        {event.location && <span> &middot; {event.location}</span>}
      </p>
    )}
    {event.shortDescription && <p class="event-card__summary">{event.shortDescription}</p>}

    <div class="event-card__actions">
      <a class="btn" href={eventLink}>
        View details
      </a>
      {event.youtubeUrl && (
        <a
          class="btn outline"
          href={event.youtubeUrl}
          target="_blank"
          rel="noreferrer"
          aria-label={`Watch ${event.title} on YouTube`}
        >
          Watch video
        </a>
      )}
    </div>
  </div>
</article>

<style>
  .event-card {
    display: grid;
    gap: 1.5rem;
    background: rgba(255, 255, 255, 0.9);
  }

  .event-card.featured {
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    background: linear-gradient(135deg, rgba(75, 29, 149, 0.08), rgba(13, 148, 136, 0.08));
    border: 1px solid rgba(75, 29, 149, 0.08);
  }

  .event-card__cover {
    display: block;
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-base);
    box-shadow: var(--shadow-card);
  }

  .event-card__cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 200ms ease;
  }

  .event-card__cover:hover img,
  .event-card__cover:focus-visible img {
    transform: scale(1.03);
  }

  .event-card__placeholder {
    aspect-ratio: 16 / 10;
    display: grid;
    place-items: center;
    background: linear-gradient(135deg, rgba(75, 29, 149, 0.15), rgba(245, 158, 11, 0.15));
    color: var(--color-primary-dark);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }

  .event-card__badge {
    position: absolute;
    bottom: 1rem;
    left: 1rem;
  }

  .event-card__content h3 {
    margin-bottom: 0.75rem;
    font-size: clamp(1.3rem, 1.7vw, 1.45rem);
  }

  .event-card__content h3 a {
    color: inherit;
  }

  .event-card__meta {
    color: var(--color-text-muted);
    margin-bottom: 0.9rem;
  }

  .event-card__summary {
    margin-bottom: 1.35rem;
    color: var(--color-text-muted);
    max-width: 45ch;
  }

  .event-card__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
  }

  .event-card__tags {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-bottom: 0.75rem;
  }

  .tag {
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 0.25rem 0.6rem;
    border-radius: 999px;
    background: rgba(75, 29, 149, 0.18);
    color: var(--color-primary-dark);
    font-weight: 600;
  }

  @media (max-width: 720px) {
    .event-card.featured {
      grid-template-columns: 1fr;
    }
  }
</style>
