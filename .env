# --- Sanity (content) ---
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_API_VERSION=2023-10-01
# Optional read token (use a READ-only token; not required if your GROQ is public):
SANITY_READ_TOKEN=<sanity_read_token_if_needed>

# --- Firebase (functions / optional Firestore) ---
FIREBASE_PROJECT_ID=
# Only needed if your client uses Firebase client SDKs:
VITE_FIREBASE_API_KEY=<...>
VITE_FIREBASE_AUTH_DOMAIN=<...>
VITE_FIREBASE_PROJECT_ID=<...>
VITE_FIREBASE_APP_ID=<...>

# --- Email / RSVP (optional) ---
SENDGRID_API_KEY=<your_sendgrid_key>
RSVP_INBOX=<your_inbox_email>

# --- App ---
PUBLIC_SITE_URL=http://localhost:4321
